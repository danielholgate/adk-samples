# ==============================================================================
# Data Quality Agent - Environment Configuration
# ==============================================================================

# Gemini model used to power the data quality agent.
# Recommended: gemini-2.5-flash or gemini-2.5-pro
AGENT_MODEL="gemini-2.5-flash"

# Google Cloud project ID containing your BigQuery datasets and Dataplex assets.
GOOGLE_CLOUD_PROJECT="cloud-summit-data-analytics"

# Google Cloud region where Dataplex is configured.
DATAPLEX_REGION="us-central1"

# Integration with Google Vertex AI using Application Default Credentials (ADC)
GOOGLE_GENAI_USE_VERTEXAI="1"
GOOGLE_GENAI_LOCATION="us-central1"
